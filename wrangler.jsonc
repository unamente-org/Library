// Cloudflare hosting settings for the library (Workers with static assets; no server code).
// The site is plain files built by Hugo into public/; _redirects in public/ forwards old addresses.
{
  "name": "unamente-library",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
